{
  "name": "writers-room",
  "private": true,
  "version": "0.0.1",
  "description": "Writers Room: private, self-hosted collaborative screenwriting for Idu House.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @writers-room/server migrate",
    "cli": "pnpm --filter @writers-room/server cli"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
