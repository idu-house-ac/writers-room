# Copy to .env and edit. Docker Compose reads this file automatically.

# Random string, at least 32 characters. Signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string-please

# Database password used inside Docker Compose.
POSTGRES_PASSWORD=writers-room-dev

# Where the web app is reached in the browser. Links in emails point here.
APP_ORIGIN=http://localhost:5173

# The first account. Created on server start if no account with this email exists.
# Accounts are invite-only, so this is how the first Owner gets in.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=change-me-please

# Backups: time of day (24h, server clock) and how many days of dumps to keep.
BACKUP_TIME=03:00
BACKUP_KEEP_DAYS=30
